<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Seguridad Familiar 2026</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>seguridad_familiar</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Permisos de Ubicación Continua -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>La aplicación requiere acceso permanente a la ubicación en segundo plano para proteger a tu familia y despachar auxilio en caso de caídas, batería crítica o botón de pánico.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Se requiere tu ubicación para mostrar tu posición en el mapa seguro en tiempo real.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>El rastreo en segundo plano es indispensable para la detección de desvíos de ruta e inmovilidad anómala.</string>

	<!-- Permisos de Micrófono y Cámara para Caja Negra y Coacción -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Permite grabar clips de audio ambiente de 15 segundos en situaciones de emergencia o pánico.</string>
	<key>NSCameraUsageDescription</key>
	<string>Permite capturar evidencia fotográfica silenciosa en caso de activación de código de coacción.</string>

	<!-- Permisos Bluetooth Low Energy Mesh Offline -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Permite emitir y recibir balizas de auxilio P2P cuando no hay cobertura de datos celulares.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Permite comunicar alertas a dispositivos cercanos sin Internet.</string>

	<!-- Modos en Segundo Plano Requeridos -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
		<string>processing</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
	</array>

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
